rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /businesses/{businessId} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;

      match /clients/{clientId} {
        allow read, write: if request.auth != null && request.auth.uid == businessId;

        match /requests/{requestId} {
          allow read, write: if request.auth != null && request.auth.uid == businessId;

          match /items/{itemId} {
            allow read, write: if request.auth != null && request.auth.uid == businessId;
          }

          match /reminders/{reminderId} {
            allow read: if request.auth != null && request.auth.uid == businessId;
          }
        }
      }
    }

    // NEW — required specifically for the dashboard's collectionGroup('requests') query
    match /{path=**}/requests/{requestId} {
      allow list: if request.auth != null
      && resource.data.businessId == request.auth.uid;
    }
  }
}